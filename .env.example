# ===================================================================
#  Copia este archivo como ".env" y completa los valores.
#  El archivo ".env" NO se sube al repositorio (está en .gitignore).
# ===================================================================

# --- Base de datos MySQL (local) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anita_new_local

# --- Seguridad (cambia estos valores; en producción deben ser largos y aleatorios) ---
SECRET_KEY=cambia-esto-por-una-clave-larga
JWT_SECRET_KEY=cambia-esto-por-otra-clave-larga

# --- Frontends que pueden usar esta API (separados por coma, sin "/" al final) ---
# Local: tienda en 5173 y panel de administración en 5174.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
# URL de la tienda (para los enlaces de los correos). Si la dejas vacía usa el primer origen.
FRONTEND_TIENDA_URL=http://localhost:5173
# Solo en producción con dominio propio (con punto inicial), para compartir la sesión entre subdominios:
# COOKIE_DOMAIN=.midominio.com

# --- Correo (Resend). Si RESEND_API_KEY queda vacío, los correos se imprimen en la consola ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-responder@midominio.com

# --- Inicio de sesión con Google (opcional). Mismo ID que VITE_GOOGLE_CLIENT_ID en el frontend ---
GOOGLE_CLIENT_ID=

# --- Libro de Reclamaciones: datos del proveedor que salen impresos en la hoja ---
PROVEEDOR_RAZON_SOCIAL=
PROVEEDOR_RUC=
PROVEEDOR_DOMICILIO=
# Correo donde llega el aviso de cada reclamo nuevo (opcional)
RECLAMOS_EMAIL_DESTINO=

# --- Imágenes (Vercel Blob). Sin token no se pueden subir imágenes de producto ---
BLOB_READ_WRITE_TOKEN=

# --- Pagos con Culqi y validación de DNI/RUC (se piensa quitar en la versión simplificada) ---
CULQI_SECRET_KEY=
CULQI_BASE_URL=https://api.culqi.com
MINUTOS_LIMITE_PAGO=20
API_PERU_TOKEN=
API_PERU_BASE_URL=https://api.decolecta.com

# --- Solo producción ---
# FLASK_ENV=production   (activa cookies seguras; en Vercel se detecta solo)
# Redis compartido para los límites de intentos (en local se usa memoria)
REDIS_URL=
REQUIRE_REDIS_EN_PROD=false
# Secreto del cron que cancela pedidos vencidos
CRON_SECRET=
# Fracción de requests que se registran para métricas de latencia (1.0 = todos)
KPI_LATENCIA_SAMPLE_RATE=1.0
